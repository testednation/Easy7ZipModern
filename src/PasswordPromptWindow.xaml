<Window x:Class="Easy7ZipModern.PasswordPromptWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Encrypted Archive - Easy 7-Zip Modern" Width="440" Height="260"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="{DynamicResource Bg.Window}" Foreground="{DynamicResource Text.Primary}"
        FontFamily="Segoe UI" WindowStyle="SingleBorderWindow">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Text="🔒 Password Required" FontSize="18" FontWeight="SemiBold" Foreground="{DynamicResource Text.Primary}" Margin="0,0,0,16"/>
        <TextBlock Grid.Row="1" x:Name="TxtArchiveName" Text="This archive is protected with encryption." FontSize="12" Foreground="{DynamicResource Text.Muted}" TextTrimming="CharacterEllipsis" Margin="0,4,0,0"/>

        <PasswordBox Grid.Row="2" x:Name="PbPassword" Height="36" Background="{DynamicResource Bg.SurfaceAlt}" Foreground="{DynamicResource Text.Primary}" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1" Padding="8,6" FontSize="14" Margin="0,12,0,0"/>
        <CheckBox Grid.Row="3" x:Name="ChkRemember" Content="Remember this password in secure vault" IsChecked="True" Foreground="{DynamicResource Text.Secondary}" FontSize="12" Margin="0,12,0,0"/>

        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
            <Button x:Name="BtnCancel" Content="Cancel" Width="90" Height="32" Margin="0,0,10,0" Background="{DynamicResource Btn.Background}" Foreground="{DynamicResource Text.Secondary}" BorderBrush="{DynamicResource Brush.Border}" Click="BtnCancel_Click" IsCancel="True"/>
            <Button x:Name="BtnOk" Content="Unlock" Width="90" Height="32" Background="{DynamicResource Accent}" Foreground="{DynamicResource Accent.Text}" FontWeight="SemiBold" IsDefault="True" Click="BtnOk_Click"/>
        </StackPanel>
    </Grid>
</Window>
