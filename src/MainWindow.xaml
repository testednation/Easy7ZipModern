<Window x:Class="Easy7ZipModern.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:primitives="clr-namespace:System.Windows.Controls.Primitives;assembly=PresentationFramework"
        Title="Easy 7-Zip Modern - Universal Extractor Edition" Height="720" Width="1080" MinHeight="550" MinWidth="850"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource Bg.Window}" Foreground="{DynamicResource Text.Primary}" FontFamily="Segoe UI">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>

        <Style x:Key="ModernBtn" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource Btn.Background}"/>
            <Setter Property="Foreground" Value="{DynamicResource Text.Secondary}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{DynamicResource Btn.Hover}"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="{DynamicResource Accent}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{DynamicResource Btn.Pressed}"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="{DynamicResource Accent}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="border" Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="NavTabBtn" TargetType="RadioButton">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource Text.Muted}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Padding" Value="16,10"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="VerticalAlignment" Value="Stretch"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="tabBorder" Background="{TemplateBinding Background}" BorderThickness="0,3,0,0" Padding="{TemplateBinding Padding}" VerticalAlignment="Stretch">
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="tabBorder" Property="Background" Value="{DynamicResource Tab.Hover}"/>
                                <Setter Property="Foreground" Value="{DynamicResource Text.Primary}"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="tabBorder" Property="Background" Value="{DynamicResource Tab.Active}"/>
                                <Setter Property="Foreground" Value="{DynamicResource Accent}"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Breadcrumb link button -->
        <Style x:Key="CrumbBtn" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource Accent}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="4,2"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <TextBlock Text="{TemplateBinding Content}" Foreground="{TemplateBinding Foreground}" Padding="{TemplateBinding Padding}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="220"/>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="{DynamicResource AccentText}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Keyboard key cap -->
        <Style x:Key="Kbd" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource Bg.SurfaceAlt}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="4"/>
            <Setter Property="Padding" Value="8,3"/>
            <Setter Property="Margin" Value="0,0,8,8"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="HorizontalAlignment" Value="Left"/>
        </Style>
    </Window.Resources>

    <Grid x:Name="ZoomHost" Margin="0" AllowDrop="True" Drop="Window_Drop" DragOver="Window_DragOver" DragEnter="Window_DragEnter" DragLeave="Window_DragLeave">
        <Grid.LayoutTransform>
            <ScaleTransform x:Name="UiScaleTransform" ScaleX="1" ScaleY="1"/>
        </Grid.LayoutTransform>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <!-- Title bar row -->
        <Grid Background="{DynamicResource Bg.TitleBar}" Height="56">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,0,0">
                <TextBlock Text="🗂 Easy 7-Zip Modern" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource Accent}" VerticalAlignment="Center" Background="{DynamicResource Bg.TitleBar}" Padding="12,0,0,0"/>
                <Border Background="{DynamicResource Bg.SurfaceAlt}" CornerRadius="6" Padding="6,2" Margin="12,0,0,0">
                    <TextBlock Text="Universal Extractor Edition" FontSize="11" Foreground="{DynamicResource Text.Muted}" VerticalAlignment="Center"/>
                </Border>
                <Border CornerRadius="6" Padding="6,2" Margin="8,0,0,0" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1">
                    <TextBlock x:Name="TxtVersionBadge" Text="v1.4.0" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource Text.Muted}" VerticalAlignment="Center"/>
                </Border>
            </StackPanel>
            <TextBox Grid.Column="2" x:Name="TxtSearch" Width="200" Height="30" Margin="0,0,10,0" Background="{DynamicResource Bg.SurfaceAlt}" Foreground="{DynamicResource Text.Primary}" BorderBrush="{DynamicResource Brush.Border}" FontSize="12" VerticalContentAlignment="Center" TextChanged="TxtSearch_TextChanged" ToolTip="Filter items in the current folder"/>
            <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,10,0">
                <Button x:Name="BtnZoomOut" Content="−" Style="{StaticResource ModernBtn}" Width="28" Height="28" Padding="0" FontSize="14" FontWeight="Bold" Click="BtnZoomOut_Click" ToolTip="Zoom out (Ctrl+Minus)"/>
                <Border Background="{DynamicResource Bg.SurfaceAlt}" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1" CornerRadius="4" Margin="4,0" MinWidth="52" Height="28">
                    <TextBlock x:Name="TxtZoomLevel" Text="100%" FontSize="11" Foreground="{DynamicResource Text.Secondary}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <Button x:Name="BtnZoomIn" Content="+" Style="{StaticResource ModernBtn}" Width="28" Height="28" Padding="0" FontSize="14" FontWeight="Bold" Click="BtnZoomIn_Click" ToolTip="Zoom in (Ctrl+Plus)"/>
                <Button x:Name="BtnZoomReset" Content="⟲" Style="{StaticResource ModernBtn}" Width="28" Height="28" Padding="0" FontSize="13" Margin="4,0,0,0" Click="BtnZoomReset_Click" ToolTip="Reset zoom to 100% (Ctrl+0)"/>
            </StackPanel>
            <Button Grid.Column="4" x:Name="BtnToggleTheme" Content="🌗 Dark" Style="{StaticResource ModernBtn}" Height="30" Padding="10,4" MinWidth="96" Click="BtnToggleTheme_Click" ToolTip="Cycle theme: Dark → Light → Midnight → High Contrast"/>
        </Grid>

        <!-- Nav row -->
        <Grid Grid.Row="1" Background="{DynamicResource Bg.Nav}" Height="48">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Stretch" Margin="12,0,0,0">
                <RadioButton x:Name="TabNavBrowser" Content="📁 Archive Browser" GroupName="NavTabs" IsChecked="True" Style="{StaticResource NavTabBtn}" Checked="NavTab_Checked"/>
                <RadioButton x:Name="TabNavExtractor" Content="🧠 Smart Extractor" GroupName="NavTabs" Style="{StaticResource NavTabBtn}" Checked="NavTab_Checked"/>
                <RadioButton x:Name="TabNavComponents" Content="⚙ Components &amp; Updates" GroupName="NavTabs" Style="{StaticResource NavTabBtn}" Checked="NavTab_Checked"/>
                <RadioButton x:Name="TabNavSettings" Content="🔑 Settings &amp; Vault" GroupName="NavTabs" Style="{StaticResource NavTabBtn}" Checked="NavTab_Checked"/>
            </StackPanel>
        </Grid>

        <!-- Pages row -->
        <Grid Grid.Row="2" Background="{DynamicResource Bg.Page}">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- ==================== PAGE 1 : BROWSER ==================== -->
            <Grid x:Name="PageBrowser" Visibility="Visible" Background="{DynamicResource Bg.Page}"
                  AllowDrop="True" Drop="PageBrowser_Drop" DragOver="PageBrowser_DragOver" DragEnter="PageBrowser_DragEnter" DragLeave="PageBrowser_DragLeave">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <Border Background="{DynamicResource Bg.Surface}" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="0,0,0,1" Padding="12,6">
                    <WrapPanel Orientation="Horizontal">
                        <Button x:Name="BtnOpen" Content="📂 Open" Style="{StaticResource ModernBtn}" Margin="0,0,6,4" Click="BtnOpen_Click"/>
                        <Button x:Name="BtnExtractTo" Content="📦 Extract To..." Style="{StaticResource ModernBtn}" Margin="0,0,6,4" Click="BtnExtractTo_Click"/>
                        <Button x:Name="BtnQuickExtractHere" Content="⚡ Quick Extract" Style="{StaticResource ModernBtn}" Margin="0,0,6,4" Click="BtnQuickExtractHere_Click"/>
                        <Button x:Name="BtnAdd" Content="➕ Add / Compress" Style="{StaticResource ModernBtn}" Margin="0,0,6,4" Click="BtnAdd_Click"/>
                        <Button x:Name="BtnTest" Content="🧪 Test Integrity" Style="{StaticResource ModernBtn}" Margin="0,0,6,4" Click="BtnTest_Click"/>
                        <Button x:Name="BtnDelete" Content="🗑 Delete" Style="{StaticResource ModernBtn}" Margin="0" Click="BtnDelete_Click"/>
                    </WrapPanel>
                </Border>
                <Grid Grid.Row="1" Background="{DynamicResource Bg.Surface}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Border Background="{DynamicResource Bg.SurfaceAlt}" BorderBrush="{DynamicResource Brush.Divider}" BorderThickness="0,0,0,1" Padding="12,4">
                        <DockPanel>
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,0,0">
                                <Button x:Name="BtnToggleTree" Content="🗂 Tree" Style="{StaticResource ModernBtn}" Height="26" Padding="8,2" FontSize="11" Click="BtnToggleTree_Click" ToolTip="Show or hide the folder tree panel"/>
                                <TextBlock Text="💡 or drag an archive anywhere" FontSize="11" Foreground="{DynamicResource Text.Muted}" VerticalAlignment="Center" Margin="10,0,0,0"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <Button x:Name="BtnBack" Content="⬅" Style="{StaticResource ModernBtn}" Height="26" Width="26" Padding="0" Margin="0,0,4,0" Click="BtnBack_Click" ToolTip="Back" IsEnabled="False"/>
                                <Button x:Name="BtnForward" Content="➡" Style="{StaticResource ModernBtn}" Height="26" Width="26" Padding="0" Margin="0,0,4,0" Click="BtnForward_Click" ToolTip="Forward" IsEnabled="False"/>
                                <Button x:Name="BtnUpFolder" Content="⬆️" Style="{StaticResource ModernBtn}" Height="26" Width="26" Padding="0" Margin="0,0,8,0" Click="BtnUpFolder_Click" ToolTip="Up one folder (Backspace)" IsEnabled="False"/>
                                <ScrollViewer VerticalScrollBarVisibility="Disabled" HorizontalScrollBarVisibility="Hidden" VerticalAlignment="Center" MaxWidth="640">
                                    <ItemsControl x:Name="BrCrumb">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <StackPanel Orientation="Horizontal"/>
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <StackPanel Orientation="Horizontal">
                                                    <Button Content="{Binding Name}" Tag="{Binding FullPath}" Style="{StaticResource CrumbBtn}" Click="BtnCrumb_Click" ToolTipService.ShowOnDisabled="True"/>
                                                    <TextBlock Text="›" Margin="2,0" Foreground="{DynamicResource Text.Muted}" VerticalAlignment="Center" Visibility="{Binding SeparatorVisibility}"/>
                                                </StackPanel>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                            </StackPanel>
                        </DockPanel>
                    </Border>
                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="220" MinWidth="140"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Border x:Name="TreePanel" Background="{DynamicResource Bg.SurfaceAlt}" BorderBrush="{DynamicResource Brush.Divider}" BorderThickness="0,0,1,0">
                            <DockPanel>
                                <Border DockPanel.Dock="Top" Background="{DynamicResource Col.Header}" Padding="10,5">
                                    <TextBlock Text="FOLDERS" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource Text.Secondary}"/>
                                </Border>
                                <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                                    <TreeView x:Name="TvFolders" Background="Transparent" BorderThickness="0"
                                              Foreground="{DynamicResource Text.Primary}" SelectedItemChanged="TvFolders_SelectedItemChanged"
                                              MinWidth="200">
                                        <TreeView.ItemContainerStyle>
                                            <Style TargetType="TreeViewItem">
                                                <Setter Property="Foreground" Value="{DynamicResource Text.Primary}"/>
                                                <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}"/>
                                                <Setter Property="IsSelected" Value="{Binding IsSelected, Mode=TwoWay}"/>
                                            </Style>
                                        </TreeView.ItemContainerStyle>
                                        <TreeView.ItemTemplate>
                                            <HierarchicalDataTemplate ItemsSource="{Binding Children}">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="📁" Margin="0,0,5,0"/>
                                                    <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" MaxWidth="260"/>
                                                </StackPanel>
                                            </HierarchicalDataTemplate>
                                        </TreeView.ItemTemplate>
                                    </TreeView>
                                </ScrollViewer>
                            </DockPanel>
                        </Border>
                        <GridSplitter Grid.Column="1" x:Name="TreeSplitter" Width="6" HorizontalAlignment="Center" VerticalAlignment="Stretch"
                                      Background="{DynamicResource Brush.Divider}" ResizeBehavior="PreviousAndNext" ResizeDirection="Columns"/>
                        <DataGrid Grid.Column="2" x:Name="DgArchiveItems" AutoGenerateColumns="False"
                              Background="{DynamicResource Bg.Page}" Foreground="{DynamicResource Text.Primary}"
                              RowBackground="{DynamicResource Row.Background}" AlternatingRowBackground="{DynamicResource Row.Alt}"
                              GridLinesVisibility="None" HeadersVisibility="Column" SelectionMode="Extended" CanUserAddRows="False" IsReadOnly="True" MouseDoubleClick="DgArchiveItems_MouseDoubleClick"
                              SelectionChanged="DgArchiveItems_SelectionChanged" PreviewKeyDown="DgArchiveItems_PreviewKeyDown">
                        <DataGrid.ColumnHeaderStyle>
                            <Style TargetType="{x:Type primitives:DataGridColumnHeader}">
                                <Setter Property="Background" Value="{DynamicResource Col.Header}"/>
                                <Setter Property="Foreground" Value="{DynamicResource Text.Secondary}"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                                <Setter Property="Padding" Value="8,6"/>
                                <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border}"/>
                                <Setter Property="BorderThickness" Value="0,0,1,1"/>
                            </Style>
                        </DataGrid.ColumnHeaderStyle>
                        <DataGrid.RowStyle>
                            <Style TargetType="DataGridRow">
                                <Setter Property="Foreground" Value="{DynamicResource Text.Primary}"/>
                            </Style>
                        </DataGrid.RowStyle>
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="*"/>
                            <DataGridTextColumn Header="Type" Binding="{Binding TypeDescription}" Width="110"/>
                            <DataGridTextColumn Header="Size" Binding="{Binding DisplaySize}" Width="100"/>
                            <DataGridTextColumn Header="Packed Size" Binding="{Binding DisplayCompressedSize}" Width="100"/>
                            <DataGridTextColumn Header="Modified" Binding="{Binding DisplayModified}" Width="150"/>
                            <DataGridTextColumn Header="Attributes" Binding="{Binding Attributes}" Width="90"/>
                        </DataGrid.Columns>                        </DataGrid>
                    <Border Grid.Column="2" x:Name="BrowserDropOverlay" Background="#660067C0" BorderBrush="{DynamicResource Accent}" BorderThickness="2" CornerRadius="8" Margin="8" Visibility="Collapsed" IsHitTestVisible="False">
                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                            <TextBlock Text="📂 Drop archive to open" FontSize="22" FontWeight="Bold" Foreground="{DynamicResource Accent}" HorizontalAlignment="Center"/>
                            <TextBlock Text=".7z · .zip · .rar · .tar · .zst · .iso · installers route to the Smart Extractor" FontSize="12" Foreground="{DynamicResource Text.Secondary}" HorizontalAlignment="Center" Margin="0,6,0,0"/>
                        </StackPanel>
                    </Border>
                    </Grid>
                    <Border Grid.Row="2" Background="{DynamicResource Bg.Statusbar}" BorderBrush="{DynamicResource Brush.Divider}" BorderThickness="0,1,0,0" Padding="12,4">
                        <DockPanel>
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock x:Name="TxtStatusTotalSize" Text="Size: 0 B" Foreground="{DynamicResource Text.Muted}" Margin="0,0,16,0"/>
                                <TextBlock x:Name="TxtStatusArchiveType" Text="Engine: Ready" Foreground="{DynamicResource Accent}" Margin="0,0,16,0"/>
                                <TextBlock x:Name="TxtStatusEncryption" Text="🔓 Decrypted" Foreground="{DynamicResource Text.Muted}"/>
                            </StackPanel>
                            <TextBlock x:Name="TxtStatusItems" Text="0 items · 0 selected" Foreground="{DynamicResource Text.Muted}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                            <TextBlock x:Name="TxtStatusSelected" Text="" Foreground="{DynamicResource Text.Muted}" Visibility="Collapsed"/>
                        </DockPanel>
                    </Border>
                </Grid>
            </Grid>

            <!-- ==================== PAGE 2 : SMART EXTRACTOR ==================== -->
            <ScrollViewer x:Name="PageExtractor" Visibility="Collapsed" VerticalScrollBarVisibility="Auto" Padding="28,0,28,28" MaxWidth="800" HorizontalAlignment="Left">
                <StackPanel>
                    <TextBlock Text="🧠 Smart Multi-Engine Extractor" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource Text.Primary}" Margin="0,0,0,4"/>
                    <TextBlock Text="Extract any archive, installer (Inno, InstallShield, Wise), or MSI package automatically." FontSize="13" Foreground="{DynamicResource Text.Muted}" Margin="0,4,0,20"/>

                    <Border x:Name="DropZone" Height="140" Background="{DynamicResource Bg.DropZone}" BorderBrush="{DynamicResource Accent}" BorderThickness="1" AllowDrop="True" Margin="0,0,0,20" Cursor="Hand" Drop="DropZone_Drop" DragOver="DropZone_DragOver">
                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                            <TextBlock Text="📥⬇️" FontSize="36" HorizontalAlignment="Center" Margin="0,0,0,6"/>
                            <TextBlock Text="Drag and drop archives or installers here" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource Text.Primary}" HorizontalAlignment="Center"/>
                            <TextBlock Text="Supports .7z, .zip, .rar, .zst, Inno .exe, InstallShield .cab, MSI, PEA, and more" FontSize="12" Foreground="{DynamicResource Text.Muted}" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                        </StackPanel>
                    </Border>

                    <TextBlock Text="Source Archive / Installer:" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,6"/>
                    <Grid Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="TxtSourceArchive" Background="{DynamicResource Bg.SurfaceAlt}" Foreground="{DynamicResource Text.Primary}" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1" Padding="8,6" FontSize="12" VerticalContentAlignment="Center"/>
                        <Button Grid.Column="1" x:Name="BtnBrowseSource" Content="Browse..." Style="{StaticResource ModernBtn}" Height="34" Margin="8,0,0,0" Click="BtnBrowseSource_Click"/>
                    </Grid>

                    <TextBlock Text="Extraction Destination Folder:" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,6"/>
                    <Grid Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="TxtDestDir" Background="{DynamicResource Bg.SurfaceAlt}" Foreground="{DynamicResource Text.Primary}" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1" Padding="8,6" FontSize="12" VerticalContentAlignment="Center"/>
                        <Button Grid.Column="1" x:Name="BtnBrowseDest" Content="Browse..." Style="{StaticResource ModernBtn}" Height="34" Margin="8,0,0,0" Click="BtnBrowseDest_Click"/>
                    </Grid>

                    <Border Background="{DynamicResource Bg.Card}" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1" CornerRadius="6" Padding="16" Margin="0,0,0,20">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                                <TextBlock Text="Detected Engine:" FontWeight="SemiBold" Foreground="{DynamicResource Text.Secondary}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <TextBlock x:Name="TxtSmartEngine" Text="Auto-Detect (7-Zip + UniExtract Suite)" Foreground="{DynamicResource Accent}" FontWeight="Bold" VerticalAlignment="Center"/>
                            </StackPanel>
                            <CheckBox x:Name="ChkSmartSubfolder" Content="Extract into a clean subfolder named after archive" IsChecked="True" Foreground="{DynamicResource Text.Secondary}" Margin="0,0,0,8"/>
                            <CheckBox x:Name="ChkOpenFolderAfter" Content="Open destination folder when extraction finishes" IsChecked="True" Foreground="{DynamicResource Text.Secondary}" Margin="0,0,0,8"/>
                            <CheckBox x:Name="ChkDeleteSourceAfter" Content="Delete source archive after successful extraction" IsChecked="False" Foreground="{DynamicResource Text.Secondary}"/>
                            <Button x:Name="BtnStartSmartExtract" Content="🚀 Extract Archive Now" Style="{StaticResource ModernBtn}" Height="40" FontSize="14" Margin="0,16,0,0" Click="BtnStartSmartExtract_Click"/>
                        </StackPanel>
                    </Border>

                    <StackPanel x:Name="SmartProgressPanel" Visibility="Collapsed" Margin="0,0,0,16">
                        <ProgressBar x:Name="SmartProgressBar" Minimum="0" Maximum="100" Value="0" Background="{DynamicResource Bg.SurfaceAlt}" Foreground="{DynamicResource Accent}" Margin="0,6,0,0"/>
                        <Grid Margin="0,6,0,0">
                            <TextBlock x:Name="TxtSmartCurrentFile" Text="Extracting files..." Foreground="{DynamicResource Text.Secondary}" TextTrimming="CharacterEllipsis" HorizontalAlignment="Left" MaxWidth="600"/>
                            <TextBlock x:Name="TxtSmartPercent" Text="0%" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource Accent}" HorizontalAlignment="Right"/>
                        </Grid>
                    </StackPanel>

                    <TextBlock Text="Extraction Log:" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource Text.Muted}" Margin="0,0,0,4"/>
                    <TextBox x:Name="TxtExtractorLog" Height="100" Background="{DynamicResource Bg.Log}" Foreground="{DynamicResource Brush.Success}" FontFamily="Consolas" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1" IsReadOnly="True" VerticalScrollBarVisibility="Auto"/>
                </StackPanel>
            </ScrollViewer>

            <!-- ==================== PAGE 3 : COMPONENTS & PLUGINS ==================== -->
            <ScrollViewer x:Name="PageComponents" Visibility="Collapsed" VerticalScrollBarVisibility="Auto" Padding="28,0,28,28" MaxWidth="850" HorizontalAlignment="Left">
                <StackPanel>
                    <TextBlock Text="⚙ Modular Components &amp; UniExtract Plugins" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource Text.Primary}" Margin="0,0,0,4"/>
                    <TextBlock Text="Automatically download updates and install unpackers inline with real-time progress." FontSize="13" Foreground="{DynamicResource Text.Muted}" Margin="0,4,0,16"/>

                    <Border Background="{DynamicResource Bg.Card}" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1" CornerRadius="6" Padding="16" Margin="0,0,0,20">
                        <DockPanel>
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,0,0">
                                <Button x:Name="BtnCheckUpdates" Content="🔄 Check Updates" Style="{StaticResource ModernBtn}" Height="34" Margin="0,0,8,0" Click="BtnCheckUpdates_Click"/>
                                <Button x:Name="BtnUpdateAll" Content="⬇️ Download / Update All" Style="{StaticResource ModernBtn}" Click="BtnUpdateAll_Click"/>
                            </StackPanel>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="🛠 Automatic Component &amp; Plugin Updater" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource Accent}" TextTrimming="CharacterEllipsis"/>
                                <TextBlock Text="Installs all modern codecs (Zstd, Brotli), Inno/InstallShield unpackers, and LessMSI directly into Easy 7-Zip." FontSize="12" Foreground="{DynamicResource Text.Secondary}" Margin="0,4,0,0" TextWrapping="Wrap"/>
                            </StackPanel>
                        </DockPanel>
                    </Border>

                    <!-- EDITABLE PLUGIN URLS -->
                    <Border Background="{DynamicResource Bg.Card}" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1" CornerRadius="6" Padding="16" Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock Text="🔗 Plugin Source URLs (editable)" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource Text.Primary}" Margin="0,0,0,4"/>
                            <TextBlock Text="Change where components are downloaded from. Supports any GitHub releases, mirrors, or direct file URLs." FontSize="11" Foreground="{DynamicResource Text.Muted}" Margin="0,0,0,10" TextWrapping="Wrap"/>
                            <ItemsControl x:Name="IcPluginUrls">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,0,0,6">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="160"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding Name}" Foreground="{DynamicResource Text.Secondary}" FontSize="11" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" ToolTip="{Binding Name}"/>
                                            <TextBox Grid.Column="1" Text="{Binding DownloadUrl, UpdateSourceTrigger=PropertyChanged}" Background="{DynamicResource Bg.SurfaceAlt}" Foreground="{DynamicResource Text.Primary}" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1" Padding="6,4" FontSize="11" VerticalContentAlignment="Center"/>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                <Button x:Name="BtnSaveUrls" Content="💾 Save URLs" Style="{StaticResource ModernBtn}" Height="30" Click="BtnSaveUrls_Click"/>
                                <Button x:Name="BtnResetUrls" Content="↩ Reset to Defaults" Style="{StaticResource ModernBtn}" Height="30" Margin="8,0,0,0" Click="BtnResetUrls_Click"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- ADD CUSTOM PLUGIN -->
                    <Border Background="{DynamicResource Bg.Card}" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1" CornerRadius="6" Padding="16" Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock Text="➕ Add Custom Plugin / Component" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource Text.Primary}" Margin="0,0,0,4"/>
                            <TextBlock Text="Point at any .zip / .7z archive URL. Files will be extracted into bin\&lt;name&gt;\ and detected automatically." FontSize="11" Foreground="{DynamicResource Text.Muted}" Margin="0,0,0,10" TextWrapping="Wrap"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="180"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <TextBlock Text="Plugin Name:" Foreground="{DynamicResource Text.Secondary}" FontSize="11" VerticalAlignment="Center"/>
                                <TextBox Grid.Column="1" x:Name="TxtNewPluginName" Background="{DynamicResource Bg.SurfaceAlt}" Foreground="{DynamicResource Text.Primary}" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1" Padding="6,4" FontSize="11" Margin="0,0,0,6"/>
                                <TextBlock Grid.Row="1" Text="Download URL:" Foreground="{DynamicResource Text.Secondary}" FontSize="11" VerticalAlignment="Center"/>
                                <TextBox Grid.Row="1" Grid.Column="1" x:Name="TxtNewPluginUrl" Background="{DynamicResource Bg.SurfaceAlt}" Foreground="{DynamicResource Text.Primary}" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1" Padding="6,4" FontSize="11" Margin="0,0,0,6"/>
                                <TextBlock Grid.Row="2" Text="Verification File:" Foreground="{DynamicResource Text.Secondary}" FontSize="11" VerticalAlignment="Center" ToolTip="A file that will exist after successful install (relative to bin folder or app folder). Optional."/>
                                <TextBox Grid.Row="2" Grid.Column="1" x:Name="TxtNewPluginVerify" Background="{DynamicResource Bg.SurfaceAlt}" Foreground="{DynamicResource Text.Primary}" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1" Padding="6,4" FontSize="11" Margin="0,0,0,6"/>
                                <Button Grid.Row="3" Grid.Column="1" x:Name="BtnAddPlugin" Content="Add Plugin" Style="{StaticResource ModernBtn}" HorizontalAlignment="Left" Height="30" Click="BtnAddPlugin_Click"/>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- COMPONENT CARDS -->
                    <ItemsControl x:Name="IcComponents">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{DynamicResource Bg.Card}" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1" CornerRadius="6" Padding="16" Margin="0,0,0,12">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>
                                        <!-- Header: name + badge left, action buttons right -->
                                        <DockPanel>
                                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,0,0">
                                                <Button Content="⬇️ Download" Style="{StaticResource ModernBtn}" Background="{DynamicResource Bg.SurfaceAlt}" BorderBrush="{DynamicResource Brush.Border}" Padding="8,4" Foreground="{DynamicResource Accent}" FontWeight="SemiBold" Click="BtnDownloadComponent_Click">
                                                    <Button.Tag>
                                                        <Binding Path="."/>
                                                    </Button.Tag>
                                                </Button>
                                                <Button Content="✖" Style="{StaticResource ModernBtn}" Background="{DynamicResource Bg.SurfaceAlt}" BorderBrush="{DynamicResource Brush.Border}" Padding="8,4" Foreground="{DynamicResource Brush.Danger}" Click="BtnDeletePlugin_Click" ToolTip="Remove plugin from list"
                                                        Visibility="{Binding IsCustom, Converter={StaticResource BoolToVis}}" Margin="6,0,0,0">
                                                    <Button.Tag>
                                                        <Binding Path="."/>
                                                    </Button.Tag>
                                                </Button>
                                            </StackPanel>
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Name}" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource Text.Primary}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="420"/>
                                                <Border Background="{DynamicResource Bg.SurfaceAlt}" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1" CornerRadius="8" Padding="8,1" Margin="8,0,0,0" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding Category}" FontSize="10" Foreground="{DynamicResource Accent}"/>
                                                </Border>
                                            </StackPanel>
                                        </DockPanel>
                                        <TextBlock Grid.Row="1" Text="{Binding Description}" Foreground="{DynamicResource Text.Muted}" TextWrapping="Wrap" Margin="0,6,0,0"/>
                                        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,6,0,0">
                                            <TextBlock Text="Supported: " FontSize="11" Foreground="{DynamicResource Text.Muted}"/>
                                            <TextBlock Text="{Binding SupportedFormats}" FontSize="11" Foreground="{DynamicResource Text.Secondary}" Margin="0,0,16,0" TextTrimming="CharacterEllipsis" MaxWidth="330"/>
                                        </StackPanel>
                                        <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,4,0,0">
                                            <TextBlock Text="Installed: " FontSize="11" Foreground="{DynamicResource Text.Muted}"/>
                                            <TextBlock Text="{Binding InstalledVersion}" FontSize="11" Foreground="{DynamicResource Text.Secondary}" Margin="0,0,16,0"/>
                                            <TextBlock Text="Latest: " FontSize="11" Foreground="{DynamicResource Text.Muted}"/>
                                            <TextBlock Text="{Binding LatestVersion}" FontSize="11" Foreground="{DynamicResource Brush.Success}"/>
                                            <TextBlock Text="{Binding Status}" FontSize="11" Foreground="{DynamicResource Accent}" Margin="16,0,0,0" FontWeight="SemiBold"/>
                                        </StackPanel>
                                        <StackPanel Grid.Row="4" Visibility="{Binding IsDownloading, Converter={StaticResource BoolToVis}}" Margin="0,12,0,0">
                                            <ProgressBar Minimum="0" Maximum="100" Value="{Binding DownloadProgress}" Background="{DynamicResource Bg.SurfaceAlt}" Foreground="{DynamicResource Accent}" Height="4"/>
                                            <Grid Margin="0,4,0,0">
                                                <TextBlock Text="{Binding ProgressText}" FontSize="10" Foreground="{DynamicResource Text.Muted}" HorizontalAlignment="Left"/>
                                                <TextBlock Text="{Binding DownloadSpeed}" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource Accent}" HorizontalAlignment="Right"/>
                                            </Grid>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </ScrollViewer>

            <!-- ==================== PAGE 4 : SETTINGS ==================== -->
            <ScrollViewer x:Name="PageSettings" Visibility="Collapsed" VerticalScrollBarVisibility="Auto" Padding="28,0,28,28" MaxWidth="750" HorizontalAlignment="Left">
                <StackPanel>
                    <TextBlock Text="⚙ Settings &amp; Password Vault" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource Text.Primary}" Margin="0,0,0,4"/>
                    <TextBlock Text="Configure double-click extraction, manage saved passwords, and customize defaults." FontSize="13" Foreground="{DynamicResource Text.Muted}" Margin="0,4,0,20"/>

                    <Border Background="{DynamicResource Bg.Card}" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1" CornerRadius="6" Padding="18" Margin="0,0,0,20">
                        <StackPanel>
                            <TextBlock Text="Double-Click to Extract Feature" FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource Text.Primary}" Margin="0,0,0,4"/>
                            <TextBlock Text="When you double-click an archive file (.zip, .7z, .rar, .tar, .zst) in Windows Explorer:" FontSize="12" Foreground="{DynamicResource Text.Muted}" Margin="0,0,0,12" TextWrapping="Wrap"/>
                            <RadioButton x:Name="RbDoubleClickExtract" Content="⚡ Quick Extract directly (1-click unpack to dedicated folder)" GroupName="DoubleClickAction" IsChecked="True" Foreground="{DynamicResource Text.Secondary}" FontSize="12" Margin="0,0,0,8"/>
                            <RadioButton x:Name="RbDoubleClickOpen" Content="📂 Open inside Easy 7-Zip Modern file browser" GroupName="DoubleClickAction" Foreground="{DynamicResource Text.Secondary}" FontSize="12" Margin="0,0,0,16"/>
                            <Button x:Name="BtnRegisterShell" Content="Register Explorer Double-Click Associations" Style="{StaticResource ModernBtn}" Height="34" HorizontalAlignment="Left" Click="BtnRegisterShell_Click"/>
                            <TextBlock x:Name="TxtShellStatus" Foreground="{DynamicResource Brush.Success}" Margin="0,6,0,0"/>
                        </StackPanel>
                    </Border>

                    <!-- Explorer Context Menu Integration (Easy 7-Zip Style) -->
                    <Border Background="{DynamicResource Bg.Card}" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1" CornerRadius="6" Padding="18" Margin="0,0,0,20">
                        <StackPanel>
                            <TextBlock Text="🖱 Windows Explorer Context Menu (All Files &amp; Folders)" FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource Text.Primary}" Margin="0,0,0,4"/>
                            <TextBlock Text="Integrate Easy 7-Zip context menu options when right-clicking any file or folder in Windows Explorer:" FontSize="12" Foreground="{DynamicResource Text.Muted}" Margin="0,0,0,12" TextWrapping="Wrap"/>

                            <TextBlock Text="Menu Display Style:" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource Text.Primary}" Margin="0,0,0,6"/>
                            <RadioButton x:Name="RbMenuNonCascaded" Content="📌 Show all options directly in main context menu (Visible immediately on right-click — Recommended)" GroupName="ContextMenuStyle" IsChecked="True" Foreground="{DynamicResource Text.Secondary}" FontSize="12" Margin="0,0,0,6"/>
                            <RadioButton x:Name="RbMenuCascaded" Content="📂 Cascaded sub-menu (Grouped under 'Easy 7-Zip Modern >')" GroupName="ContextMenuStyle" Foreground="{DynamicResource Text.Secondary}" FontSize="12" Margin="0,0,0,10"/>
                            <CheckBox x:Name="ChkContextMenuIcons" Content="Show icons next to context menu options" IsChecked="True" Foreground="{DynamicResource Text.Secondary}" FontSize="12" Margin="0,0,0,14"/>

                            <DockPanel Margin="0,0,0,8">
                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Button x:Name="BtnContextSelectAll" Content="Select All" Style="{StaticResource ModernBtn}" Height="24" Padding="8,2" FontSize="11" Click="BtnContextSelectAll_Click"/>
                                    <Button x:Name="BtnContextDeselectAll" Content="Deselect All" Style="{StaticResource ModernBtn}" Height="24" Padding="8,2" FontSize="11" Margin="6,0,0,0" Click="BtnContextDeselectAll_Click"/>
                                </StackPanel>
                                <TextBlock Text="Context menu items:" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource Text.Primary}" VerticalAlignment="Center"/>
                            </DockPanel>
                            <WrapPanel Margin="0,0,0,12">
                                <CheckBox x:Name="ChkItemOpen" Content="Open in Easy 7-Zip Modern" IsChecked="True" Foreground="{DynamicResource Text.Secondary}" FontSize="12" Margin="0,0,16,8"/>
                                <CheckBox x:Name="ChkItemExtractFiles" Content="Extract files..." IsChecked="True" Foreground="{DynamicResource Text.Secondary}" FontSize="12" Margin="0,0,16,8"/>
                                <CheckBox x:Name="ChkItemExtractHere" Content="Extract Here" IsChecked="True" Foreground="{DynamicResource Text.Secondary}" FontSize="12" Margin="0,0,16,8"/>
                                <CheckBox x:Name="ChkItemExtractTo" Content="Extract to &lt;Folder&gt;\" IsChecked="True" Foreground="{DynamicResource Text.Secondary}" FontSize="12" Margin="0,0,16,8"/>
                                <CheckBox x:Name="ChkItemTest" Content="Test archive" IsChecked="True" Foreground="{DynamicResource Text.Secondary}" FontSize="12" Margin="0,0,16,8"/>
                                <CheckBox x:Name="ChkItemAdd" Content="Add to archive..." IsChecked="True" Foreground="{DynamicResource Text.Secondary}" FontSize="12" Margin="0,0,16,8"/>
                                <CheckBox x:Name="ChkItemAdd7z" Content="Add to &lt;Archive&gt;.7z" IsChecked="True" Foreground="{DynamicResource Text.Secondary}" FontSize="12" Margin="0,0,16,8"/>
                                <CheckBox x:Name="ChkItemAddZip" Content="Add to &lt;Archive&gt;.zip" IsChecked="True" Foreground="{DynamicResource Text.Secondary}" FontSize="12" Margin="0,0,16,8"/>
                                <CheckBox x:Name="ChkItemCrcSha" Content="CRC SHA submenu (*, SHA-256, CRC-32...)" IsChecked="True" Foreground="{DynamicResource Text.Secondary}" FontSize="12" Margin="0,0,16,8"/>
                                <CheckBox x:Name="ChkItemScanFileType" Content="Scan file type (TrID)" IsChecked="True" Foreground="{DynamicResource Text.Secondary}" FontSize="12" Margin="0,0,16,8"/>
                            </WrapPanel>

                            <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                <Button x:Name="BtnRegisterContextMenu" Content="Register Context Menu for All Files" Style="{StaticResource ModernBtn}" Height="34" Margin="0,0,10,0" Click="BtnRegisterContextMenu_Click"/>
                                <Button x:Name="BtnUnregisterContextMenu" Content="Remove Context Menu" Style="{StaticResource ModernBtn}" Height="34" Click="BtnUnregisterContextMenu_Click"/>
                            </StackPanel>
                            <TextBlock x:Name="TxtContextMenuStatus" Foreground="{DynamicResource Brush.Success}" Margin="0,8,0,0" TextWrapping="Wrap"/>
                            <TextBlock Text="💡 If the context menu doesn't appear immediately, try restarting Windows Explorer or signing out and back in." FontSize="11" Foreground="{DynamicResource Text.Muted}" Margin="0,6,0,0" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>

                    <!-- Classic 7-Zip Native Shell Extension -->
                    <Border Background="{DynamicResource Bg.Card}" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1" CornerRadius="6" Padding="18" Margin="0,0,0,20">
                        <StackPanel>
                            <TextBlock Text="🔧 Classic 7-Zip Native Shell Extension" FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource Text.Primary}" Margin="0,0,0,4"/>
                            <TextBlock Text="Register the native 7-zip.dll COM handler (same as original 7-Zip / Easy 7-Zip). This adds the classic cascaded '7-Zip' submenu with icons directly from the 7-Zip engine. Can be used alongside or instead of the Easy 7-Zip Modern context menu above." FontSize="12" Foreground="{DynamicResource Text.Muted}" Margin="0,0,0,12" TextWrapping="Wrap"/>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,0">
                                <Button x:Name="BtnRegisterClassic7Zip" Content="Register Classic 7-Zip Shell Extension" Style="{StaticResource ModernBtn}" Height="34" Margin="0,0,10,0" Click="BtnRegisterClassic7Zip_Click"/>
                                <Button x:Name="BtnUnregisterClassic7Zip" Content="Remove Classic 7-Zip Extension" Style="{StaticResource ModernBtn}" Height="34" Click="BtnUnregisterClassic7Zip_Click"/>
                            </StackPanel>
                            <TextBlock x:Name="TxtClassic7ZipStatus" Foreground="{DynamicResource Brush.Success}" Margin="0,8,0,0" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>

                    <Border Background="{DynamicResource Bg.Card}" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1" CornerRadius="6" Padding="18" Margin="0,0,0,20">
                        <StackPanel>
                            <TextBlock Text="🔐 Remember Passwords Vault (DPAPI Encrypted)" FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource Text.Primary}" Margin="0,0,0,4"/>
                            <TextBlock Text="Securely stores your commonly used archive passwords. Automatically unlocks encrypted archives." FontSize="12" Foreground="{DynamicResource Text.Muted}" Margin="0,0,0,12" TextWrapping="Wrap"/>
                            <CheckBox x:Name="ChkAutoTryPasswords" Content="Automatically test remembered passwords on encrypted archives" IsChecked="True" Foreground="{DynamicResource Text.Secondary}" FontSize="12" Margin="0,0,0,14"/>
                            <TextBlock Text="Add Password to Vault:" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,6"/>
                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="TxtNewPassword" Background="{DynamicResource Bg.SurfaceAlt}" Foreground="{DynamicResource Text.Primary}" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1" Padding="8,4" FontSize="12" VerticalContentAlignment="Center"/>
                                <Button Grid.Column="1" x:Name="BtnAddPassword" Content="🔑 Add to Vault" Style="{StaticResource ModernBtn}" Height="32" Margin="8,0,0,0" Click="BtnAddPassword_Click"/>
                            </Grid>
                            <TextBlock Text="Saved Passwords:" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,6"/>
                            <ListBox x:Name="LbPasswords" Height="110" Background="{DynamicResource Bg.List}" Foreground="{DynamicResource Text.Primary}" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1" Margin="0,0,0,10"/>
                            <StackPanel Orientation="Horizontal">
                                <Button x:Name="BtnRemovePassword" Content="Remove Selected" Style="{StaticResource ModernBtn}" Height="28" Margin="0,0,8,0" Click="BtnRemovePassword_Click"/>
                                <Button x:Name="BtnClearPasswords" Content="Clear All" Style="{StaticResource ModernBtn}" Height="28" Click="BtnClearPasswords_Click"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Grid>

        <!-- ==================== KEYBOARD SHORTCUTS OVERLAY ==================== -->
        <Grid Grid.RowSpan="3" x:Name="ShortcutsOverlay" Panel.ZIndex="99" Visibility="Collapsed"
              Background="#88000000" MouseDown="ShortcutsOverlay_MouseDown">
            <Border Background="{DynamicResource Bg.Surface}" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1"
                    CornerRadius="10" Padding="30,24" HorizontalAlignment="Center" VerticalAlignment="Center"
                    MinWidth="480" MaxWidth="580" Margin="16">
                <StackPanel>
                    <TextBlock Text="⌨ Keyboard Shortcuts" FontSize="18" FontWeight="Bold"
                               Foreground="{DynamicResource Text.Primary}" HorizontalAlignment="Center"/>

                    <TextBlock Text="Zoom" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource Accent}"
                               Margin="0,18,0,8"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="190"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Border Style="{StaticResource Kbd}"><TextBlock Text="Ctrl  +  Plus" FontFamily="Consolas" FontSize="11" Foreground="{DynamicResource Text.Primary}"/></Border>
                        <TextBlock Grid.Column="1" Text="Zoom in (also Ctrl + mouse wheel)" FontSize="12" Foreground="{DynamicResource Text.Secondary}" VerticalAlignment="Center"/>
                    </Grid>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="190"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Border Style="{StaticResource Kbd}"><TextBlock Text="Ctrl  +  Minus" FontFamily="Consolas" FontSize="11" Foreground="{DynamicResource Text.Primary}"/></Border>
                        <TextBlock Grid.Column="1" Text="Zoom out" FontSize="12" Foreground="{DynamicResource Text.Secondary}" VerticalAlignment="Center"/>
                    </Grid>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="190"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Border Style="{StaticResource Kbd}"><TextBlock Text="Ctrl  +  0" FontFamily="Consolas" FontSize="11" Foreground="{DynamicResource Text.Primary}"/></Border>
                        <TextBlock Grid.Column="1" Text="Reset zoom to 100%" FontSize="12" Foreground="{DynamicResource Text.Secondary}" VerticalAlignment="Center"/>
                    </Grid>

                    <TextBlock Text="Archive Browser navigation" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource Accent}"
                               Margin="0,16,0,8"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="190"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Border Style="{StaticResource Kbd}"><TextBlock Text="Double-click" FontFamily="Consolas" FontSize="11" Foreground="{DynamicResource Text.Primary}"/></Border>
                        <TextBlock Grid.Column="1" Text="Enter folder · preview-extract and open file" FontSize="12" Foreground="{DynamicResource Text.Secondary}" VerticalAlignment="Center"/>
                    </Grid>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="190"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Border Style="{StaticResource Kbd}"><TextBlock Text="Enter" FontFamily="Consolas" FontSize="11" Foreground="{DynamicResource Text.Primary}"/></Border>
                        <TextBlock Grid.Column="1" Text="Open the selected item" FontSize="12" Foreground="{DynamicResource Text.Secondary}" VerticalAlignment="Center"/>
                    </Grid>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="190"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Border Style="{StaticResource Kbd}"><TextBlock Text="Backspace" FontFamily="Consolas" FontSize="11" Foreground="{DynamicResource Text.Primary}"/></Border>
                        <TextBlock Grid.Column="1" Text="Up one folder" FontSize="12" Foreground="{DynamicResource Text.Secondary}" VerticalAlignment="Center"/>
                    </Grid>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="190"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Border Style="{StaticResource Kbd}"><TextBlock Text="Alt  +  ←" FontFamily="Consolas" FontSize="11" Foreground="{DynamicResource Text.Primary}"/></Border>
                        <TextBlock Grid.Column="1" Text="Back" FontSize="12" Foreground="{DynamicResource Text.Secondary}" VerticalAlignment="Center"/>
                    </Grid>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="190"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Border Style="{StaticResource Kbd}"><TextBlock Text="Alt  +  →" FontFamily="Consolas" FontSize="11" Foreground="{DynamicResource Text.Primary}"/></Border>
                        <TextBlock Grid.Column="1" Text="Forward" FontSize="12" Foreground="{DynamicResource Text.Secondary}" VerticalAlignment="Center"/>
                    </Grid>

                    <TextBlock Text="General" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource Accent}"
                               Margin="0,16,0,8"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="190"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Border Style="{StaticResource Kbd}"><TextBlock Text="F1  or  ?" FontFamily="Consolas" FontSize="11" Foreground="{DynamicResource Text.Primary}"/></Border>
                        <TextBlock Grid.Column="1" Text="Toggle this help overlay" FontSize="12" Foreground="{DynamicResource Text.Secondary}" VerticalAlignment="Center"/>
                    </Grid>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="190"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Border Style="{StaticResource Kbd}"><TextBlock Text="Esc" FontFamily="Consolas" FontSize="11" Foreground="{DynamicResource Text.Primary}"/></Border>
                        <TextBlock Grid.Column="1" Text="Close this overlay" FontSize="12" Foreground="{DynamicResource Text.Secondary}" VerticalAlignment="Center"/>
                    </Grid>

                    <Button x:Name="BtnShortcutsClose" Content="Close (Esc)" Style="{StaticResource ModernBtn}"
                            HorizontalAlignment="Center" Margin="0,18,0,0" MinWidth="110" Click="BtnShortcutsClose_Click"/>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
