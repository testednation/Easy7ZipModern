<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <AssemblyName>Easy7ZipModern</AssemblyName>
    <RootNamespace>Easy7ZipModern</RootNamespace>
    <LangVersion>11.0</LangVersion>
    <Platforms>AnyCPU;x64;x86</Platforms>
    <!-- Default to x64; pass -p:Platform=x86 to build the 32-bit variant -->
    <PlatformTarget Condition="'$(PlatformTarget)' == '' And '$(Platform)' == 'AnyCPU'">x64</PlatformTarget>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
    <AutoGenerateBindingRedirects>false</AutoGenerateBindingRedirects>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <Version>1.4.0</Version>
    <AssemblyVersion>1.4.0.0</AssemblyVersion>
    <FileVersion>1.4.0.0</FileVersion>
    <Product>Easy 7-Zip Modern</Product>
    <AssemblyTitle>Easy 7-Zip Modern - Universal Extractor Edition</AssemblyTitle>
    <ApplicationIcon>app.ico</ApplicationIcon>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Platform)' == 'x64'">
    <PlatformTarget>x64</PlatformTarget>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Platform)' == 'x86'">
    <PlatformTarget>x86</PlatformTarget>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="System.Web.Extensions" />
    <Reference Include="System.Web" />
    <Reference Include="System.Security" />
  </ItemGroup>

  <ItemGroup>
    <!-- Provides .NET Framework reference assemblies so the app builds without the VS targeting pack -->
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="All" />
  </ItemGroup>

</Project>
