<Window x:Class="Easy7ZipModern.ScanWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Scan File Type" Height="400" Width="600"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource Bg.Window}">
    <Window.Resources>
        <!-- ModernBtn must be resolvable at parse time; MainWindow's copy lives
             in its own Window.Resources and is not visible to this window. -->
        <Style x:Key="ModernBtn" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource Btn.Background}"/>
            <Setter Property="Foreground" Value="{DynamicResource Text.Secondary}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{DynamicResource Btn.Hover}"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="{DynamicResource Accent}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{DynamicResource Btn.Pressed}"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="{DynamicResource Accent}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="border" Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        
        <TextBlock x:Name="TxtTitle" Text="File Signature Analysis:" FontWeight="Bold" Foreground="{DynamicResource Text.Primary}" Margin="0,0,0,10" Grid.Row="0"/>
        
        <TextBox x:Name="TxtResults" Grid.Row="1" IsReadOnly="True" TextWrapping="Wrap" 
                 VerticalScrollBarVisibility="Auto" 
                 Background="{DynamicResource Bg.Card}" 
                 Foreground="{DynamicResource Text.Primary}" 
                 BorderBrush="{DynamicResource Brush.Border}" 
                 FontFamily="Consolas" Padding="5" />
                 
        <Button Content="Close" Grid.Row="2" HorizontalAlignment="Right" Margin="0,10,0,0" Width="100" Height="30" Click="BtnClose_Click" Style="{StaticResource ModernBtn}" />
    </Grid>
</Window>
